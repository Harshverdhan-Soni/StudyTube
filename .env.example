# You normally don't edit this file: the app's Settings screen (⚙) writes it.

# --- Search (free) -----------------------------------------------------------
YOUTUBE_API_KEY=

# --- Who writes the notes: gemini | groq | ollama | anthropic -----------------
LLM_PROVIDER=gemini

# Gemini (free tier). Blank = reuse YOUTUBE_API_KEY (works if that key allows the Gemini API too)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# 1 = if a video has no transcript, let Gemini watch the video itself
GEMINI_VIDEO_FALLBACK=1

# Groq (free tier): notes for short videos, and Whisper transcription when captions are missing
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
WHISPER_MODEL=whisper-large-v3-turbo
MAX_WHISPER_SECONDS=3600

# Ollama (local, free)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Anthropic (paid)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Look: system | light | dark (the theme button in the app changes this)
THEME=system

# --- Tuning ------------------------------------------------------------------
MIN_VIDEO_SECONDS=180
MAX_VIDEO_SECONDS=10800
TRANSCRIPT_LANGS=en,en-IN,en-US,en-GB,hi
